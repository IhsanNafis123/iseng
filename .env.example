# Salin file ini menjadi .env dan isi nilai yang sesuai

# Kunci API GhostGPT (didapat dari https://ghostgpt.io/ halaman API key)
# Kunci ditampilkan hanya sekali, simpan dengan aman.
GHOSTGPT_API_KEY=Authorization: Bearer SK-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX

# Base URL API GhostGPT (OpenAI-kompatibel)
GHOSTGPT_BASE_URL=https://api.ghostgpt.io/v1

# Nama model GhostGPT
GHOSTGPT_MODEL=ghostgpt

# Suara/kreativitas asisten (0.0 - 2.0)
GHOSTGPT_TEMPERATURE=0.7

# Batas maksimal token respons (kosongkan untuk default server)
# GHOSTGPT_MAX_TOKENS=1000

# System prompt / persona asisten
GHOSTGPT_SYSTEM_PROMPT=Kamu adalah asisten AI yang ramah, membantu, dan berbicara dalam bahasa Indonesia. Jawablah pertanyaan pengguna dengan jelas, singkat, dan sopan.

# File riwayat percakapan (otomatis tersimpan setiap balasan)
GHOSTGPT_HISTORY_FILE=chat_history.jsonl
